# Production Environment Secrets Template

# Environment (development | production)
NODE_ENV=production

# Custom Domain Configuration
# Replace 'yourdomain.com' with your actual registered domain
DOMAIN_NAME=yourdomain.com
BASE_REDIRECT_URL=https://s.yourdomain.com

# Microservice Ports
PORT_GATEWAY=5000
PORT_AUTH=5001
PORT_URL=5002
PORT_REDIRECT=5003
PORT_ANALYTICS=5004

# Database Credentials (High Priority Security)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shortener_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_PASSWORD_987654321
POSTGRES_DB=shortener_production_db

# Redis Cache & Queue Credentials
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD_123456789

# JWT Authentication Secret (High Priority Security)
JWT_SECRET=super_secret_production_jwt_key_url_shortener_2026_x89q2m9
JWT_EXPIRES_IN=7d
